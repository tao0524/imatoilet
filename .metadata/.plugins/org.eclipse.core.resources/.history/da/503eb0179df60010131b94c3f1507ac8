package com.imatoilet.backend;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;

import lombok.Data;

@Entity // これをつけると、データベースに「Toilet」という表が自動で作られます！
@Data   // これをつけると、面倒な設定コードを自動で作ってくれます（Lombokの力）
public class Toilet {

    @Id // これが「会員番号」のようなIDになります
    @GeneratedValue(strategy = GenerationType.IDENTITY) // IDを1, 2, 3...と自動で増やします
    private Long id;

    private String name;        // トイレの名前
    private String address;     // 住所
    private String description; // 説明（きれい、汚い、など）
}
