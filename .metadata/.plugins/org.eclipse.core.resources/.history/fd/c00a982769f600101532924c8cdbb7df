package com.imatoilet.backend;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
// 全部まとめてインポート
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
@RequestMapping("/api/toilets")
@CrossOrigin(origins = "http://localhost:3000") // ★重要：Reactからのアクセスを許可する設定
public class ToiletApiController {

    @Autowired
    private ToiletRepository repository;

    // 1. 全件取得 (GET)
    @GetMapping
    public List<Toilet> getAllToilets() {
        return repository.findAll();
    }

    // 2. 新規登録 (POST)
    @PostMapping
    public Toilet createToilet(@RequestBody Toilet toilet) {
        // @RequestBody = 「送られてきたJSONデータを、Toiletの形に変換してね」という命令
        return repository.save(toilet);
    }

    // 3. 更新 (PUT)
    @PutMapping("/{id}")
    public Toilet updateToilet(@PathVariable Long id, @RequestBody Toilet toilet) {
        // IDをセットして上書き保存
        toilet.setId(id);
        return repository.save(toilet);
    }

    // 4. 削除 (DELETE)
    @DeleteMapping("/{id}")
    public void deleteToilet(@PathVariable Long id) {
        repository.deleteById(id);
    }
}