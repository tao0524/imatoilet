.site-header {
  padding: 15px 0;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.logo {
  font-weight: 800;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center; /* スマホは中央寄せ */
