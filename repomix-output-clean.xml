}
.filter-section:last-child { border-bottom: none; }

.filter-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #444;
  margin: 0 0 12px;
}

/* 検索ボックス周り */
.search-box-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.input-search-side {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 0.9rem;
}
.search-actions {
  display: flex;
  gap: 8px;
}
.btn-icon-side {
  flex: 1;
  background: #f5f5f5;
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 6px;
  cursor: pointer;
  color: #555;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 36px;
}
.btn-icon-side:hover {
  background: #e3f2fd;
  color: #1976d2;
  border-color: #1976d2;
}

/* ラジオボタンリスト */
.radio-group-vertical {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.radio-row {
  display: flex;
  align-items: center;
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.9rem;
  color: #555;
  transition: background 0.1s;
}
.radio-row:hover { background: #f5f5f5; }
.radio-row.active {
  background: #e3f2fd;
  color: #1565c0;
  font-weight: bold;
}
.radio-row input { display: none; }
.radio-icon { margin-right: 8px; font-size: 1.1rem; }

/* チェックボックスリスト */
.check-group-vertical {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.check-row {
  display: flex;
  align-items: center;
  padding: 6px 0;
  cursor: pointer;
  font-size: 0.9rem;
  color: #333;
}
.check-row input { display: none; }

.check-box-ui {
  width: 18px;
  height: 18px;
  border: 2px solid #ccc;
  border-radius: 4px;
  margin-right: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #fff;
  transition: all 0.2s;
}
.check-row.checked .check-box-ui {
  background: #1e88e5;
  border-color: #1e88e5;
}
.check-icon {
  margin-right: 6px;
  display: flex;
  align-items: center;
}

/* =========================
   中央カラム: 地図
========================= */
.col-map {
  position: relative;
  height: 100%;
  background: #e0e0e0;
}

/* MapPanelの上書き */
.panel--map {
  height: 100% !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  display: flex;
  flex-direction: column;
}
/* 地図上のヘッダーは不要なので消す */
.panel--map .panel-head {
  display: none; 
}
.panel--map .map-area {
  flex: 1;
  height: auto !important;
}

/* 地図の上に浮く検索ステータスバー */
.map-status-bar {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  background: rgba(255,255,255,0.95);
  padding: 8px 20px;
  border-radius: 30px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  font-size: 0.9rem;
  font-weight: bold;
  color: #1e88e5;
  border: 1px solid #bbdefb;
  white-space: nowrap; /* スマホで改行されないように */
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* =========================
   右カラム: リスト (デザイン刷新)
========================= */
.col-list {
  background: #f7f9fb; /* 背景を薄いグレーにして、カードを白く浮かせる */
  border-left: 1px solid #e0e0e0;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  z-index: 2;
  box-shadow: -4px 0 12px rgba(0,0,0,0.03);
}

/* ListPanelの上書き設定 */
.panel--list {
  height: 100%;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  display: flex;
  flex-direction: column;
  background: transparent !important; /* コンテナ自体は透明に */
}

/* リストヘッダー（固定表示） */
.panel--list .panel-head {
  padding: 16px;
  background: #fff;
  border-bottom: 1px solid #eee;
  flex-shrink: 0; /* スクロール時に縮まないように固定 */
}

.panel--list .panel-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #333;
  margin: 0 0 6px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}

.panel--list .panel-meta {
  font-size: 0.85rem;
  color: #888;
}

/* リストエリア（スクロール部分） */
.panel--list .list-area {
  flex: 1;
  overflow-y: auto;
  padding: 12px; /* カード周りの余白 */
  max-height: none !important;
  display: flex;
  flex-direction: column;
  gap: 12px; /* カード間の隙間 */
}

/* --- トイレカードのデザイン整形 --- */
.toilet-card {
  background: #fff;
  padding: 16px;
  border-radius: 12px;
  border: 1px solid #eee; /* 薄い枠線 */
  box-shadow: 0 2px 6px rgba(0,0,0,0.02); /* 優しい影 */
  cursor: pointer;
  transition: all 0.2s ease;
  position: relative;
}

/* マウスを乗せた時の動き */
.toilet-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(0,0,0,0.08);
  border-color: #bbdefb; /* 青っぽく光らせる */
}

.toilet-name {
  font-size: 1rem;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10px;
  line-height: 1.4;
}

.toilet-meta {
  font-size: 0.8rem;
  color: #666;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px; /* アイコン間の隙間 */
  line-height: 1.5;
}

/* アイコンや距離のバッジ装飾 */
.toilet-meta span {
  display: inline-flex;
  align-items: center;
  background: #f5f5f5;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 0.85rem;
