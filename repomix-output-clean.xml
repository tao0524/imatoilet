<file path="backend/backend/src/main/resources/templates/toilet-form.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>トイレ登録・編集</title>
</head>
<body>
    <h1>トイレ情報を入力</h1>
    
    <form action="/save" method="post" th:object="${toilet}">
        
        <input type="hidden" th:field="*{id}">
        
        <p>名前：<br>
        <input type="text" th:field="*{name}" required></p>
        
        <p>住所：<br>
        <input type="text" th:field="*{address}"></p>
        
        <p>説明：<br>
        <textarea th:field="*{description}" rows="3"></textarea></p>

        <hr>
        <h3>地図用の設定</h3>
        <p>緯度 (例: 36.0834)：<br>
        <input type="text" th:field="*{lat}"></p>

        <p>経度 (例: 140.1133)：<br>
        <input type="text" th:field="*{lng}"></p>

        <h3>設備情報</h3>
        <p>
            <label><input type="checkbox" th:field="*{wheelchair}"> 車椅子対応</label><br>
            <label><input type="checkbox" th:field="*{diaper}"> オムツ替えスペース</label><br>
            <label><input type="checkbox" th:field="*{open24h}"> 24時間利用可能</label>
        </p>
        <button type="submit">保存する</button>
    </form>
    
    <br>
    <a href="/">一覧に戻る</a>
</body>
</html>
</file>

<file path="backend/backend/src/main/resources/templates/toilet-list.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>トイレ検索</title>
</head>
<body>
    <h1>トイレ一覧</h1>
    
	<table border="1">
	        <thead>
	            <tr>
	                <th>ID</th>
	                <th>名前</th>
	                <th>住所</th>
	                <th>説明</th>
	                <th>操作</th> </tr>
	        </thead>
	        <tbody>
	            <tr th:each="toilet : ${toilets}">
	                <td th:text="${toilet.id}">ID</td>
	                <td th:text="${toilet.name}">名前</td>
	                <td th:text="${toilet.address}">住所</td>
	                <td th:text="${toilet.description}">説明</td>
					<td style="white-space: nowrap">
					    <a th:href="@{/edit/{id}(id=${toilet.id})}">編集</a>						
						/						
					    <a th:href="@{/delete/{id}(id=${toilet.id})}">削除</a>
					</td>
	            </tr>
	        </tbody>
	    </table>
    
    <br>
    <a href="/new">新しいトイレを登録する</a>
</body>
</html>
