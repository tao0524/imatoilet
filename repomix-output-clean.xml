}

/* 距離表示だけ少し目立たせる */
.toilet-meta span:last-child {
  background: #fff3e0;
  color: #ef6c00;
  font-weight: bold;
  margin-left: auto; /* 右端に寄せる */
}

/* =========================================
   ★モバイルレスポンシブ対応 (900px未満)
   ここを強力に修正しました
========================================= */
@media (max-width: 900px) {
  
  /* ラッパー：PCでは隠していたスクロールを有効化 */
  .search-page-wrapper {
    height: auto; 
    overflow-y: auto; 
    overflow-x: hidden;
  }

  /* 3カラムレイアウト解除 → 縦積みフレックスに変更 */
  .three-col-layout {
    display: flex;
    flex-direction: column;
    height: auto; /* 高さは中身なり */
    grid-template-columns: none;
    grid-template-rows: none;
  }

  /* 1. フィルター（上部） */
  .col-filter {
    width: 100%;
    border-right: none;
