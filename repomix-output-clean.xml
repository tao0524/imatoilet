/* =========================================
   css/pages/index.css
   トップページ専用スタイル（スマホ・PC共通）
========================================= */

/* --- 全体のレイアウト調整 --- */
body {
  background-color: #f9f9f9; /* 全体の背景色 */
}

.top-main {
  padding: 30px 0 60px;
  min-height: 80vh; /* 画面の高さを確保 */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* --- 1. ヘッダー（ロゴ） --- */
/* HTML内の .logo クラスに対する装飾 */
.site-header {
  padding: 15px 0;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.logo {
  font-weight: 800;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center; /* スマホは中央寄せ */
  color: #333;
}

.logo-icon {
  font-size: 1.8rem;
  margin: 0 4px;
}
.logo-now { color: #333; }
.logo-main { color: #1e88e5; }


/* --- 2. ヒーローエリア（キャッチコピー） --- */
.hero {
  text-align: center;
  margin-bottom: 30px;
  padding-top: 20px;
}

.catch {
  font-size: 1.8rem;
  font-weight: 800;
  line-height: 1.4;
  color: #1e88e5;
  margin-bottom: 16px;
}

.sub {
  font-size: 0.95rem;
  color: #546e7a;
  line-height: 1.6;
  font-weight: bold;
}


/* --- 3. アクションエリア（ボタン群） --- */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 400px;
  margin: 0 auto; /* 中央寄せ */
  width: 100%;
}

/* ボタン（大）の補正 */
.btn-primary, .btn-secondary {
  padding: 18px;
  font-size: 1.1rem;
  font-weight: bold;
  text-align: center;
  border-radius: 12px;
}

/* サブボタンの横並びエリア */
.sub-actions {
  display: flex;
  gap: 10px;
}

.sub-actions .btn {
  flex: 1; /* 等幅にする */
  font-size: 0.9rem;
  padding: 12px;
  text-align: center;
}

/* トイレ登録ボタン周り */
/* .btn を足して優先度を上げ、確実に青色を適用させます */
.btn.btn-register {
  background-color: #fff;
