  }
  
  /* 2. 地図（中央） */
  .col-map {
    width: 100%;
    height: 400px; /* スマホでも地図が見やすい高さを確保 */
    flex-shrink: 0;
    border-bottom: 1px solid #ddd;
  }

  /* 3. リスト（下部） */
  .col-list {
    width: 100%;
    border-left: none;
    border-top: none;
    height: auto; /* 下に伸びるように */
    flex: 1;
    box-shadow: none;
    background: #f0f2f5;
  }
  
  /* リスト内のスクロール制限を解除（ページ全体でスクロールするため） */
