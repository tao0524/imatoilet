/* =========================================
   ★PC用レイアウト（画面幅900px以上）
   ここが「見せ方を変える」魔法の部分です
========================================= */
@media (min-width: 900px) {

  /* --- 全体設定 --- */
  body {
    background-color: #f0f4f8; /* PCでは少し色味を変えてリッチに */
  }

  .site-header .container {
    max-width: 1000px;
    margin: 0 auto;
  }
  .logo {
    justify-content: flex-start; /* 左寄せ */
  }

  /* --- メインエリアをグリッド（格子状）にする --- */
  .top-main .container {
    display: grid;
    /* 左カラム(可変) + 右カラム(400px固定) */
    grid-template-columns: 1fr 400px; 
    gap: 60px;
    align-items: center; /* 上下中央揃え */
    max-width: 1000px;
    margin: 0 auto;
  }

  /* --- 左側：ヒーローエリア（文字） --- */
  .hero {
    grid-column: 1 / 2; /* 左の列に配置 */
    text-align: left;   /* 左揃え */
    padding-top: 0;
    margin-bottom: 0;
  }

  .catch {
    font-size: 3rem; /* 文字を大きく */
    margin-bottom: 24px;
  }
  .sub {
    font-size: 1.2rem; /* 説明文も大きく */
  }

  /* --- 右側：アクションエリア（操作パネル） --- */
  .actions {
    grid-column: 2 / 3; /* 右の列に配置 */
    background: #fff;
    padding: 40px;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(30, 136, 229, 0.15); /* 浮き上がらせる影 */
  }

  /* --- 下段：使い方エリア --- */
  .howto {
    grid-column: 1 / -1; /* 横幅いっぱいに広げる */
    margin-top: 80px;
    background: none;    /* 背景を消してなじませる */
    box-shadow: none;
    padding: 0;
  }

  .howto-title {
    font-size: 1.8rem;
    margin-bottom: 40px;
  }

  /* ステップを横4列に並べる */
  .howto-steps {
    flex-direction: row; 
    gap: 20px;
  }

  .howto-steps li {
    flex: 1; /* 4等分 */
    flex-direction: column; /* 中身は縦並び */
    align-items: center;
    text-align: center;
    background: #fff;
    padding: 30px 20px;
    border-radius: 16px;
    border: none;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  }

  .step-num {
    width: 50px;
    height: 50px;
    font-size: 1.2rem;
    margin-bottom: 15px;
  }
  
  .howto-cta {
    display: none; /* PC画面では下の「今すぐ探す」ボタンは不要なので隠す */
  }
}

/* =========================================
   追加：ヒーロー画像のスタイル
========================================= */

/* スマホ：文字の下に少し小さく表示 */
.hero-img {
  width: 120px;       /* 小さめに */
  height: auto;
  margin: 20px auto 0; /* 上に隙間、中央寄せ */
  display: block;
  opacity: 0.9;
}

