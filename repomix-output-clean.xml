<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>トイレ登録・編集</title>
</head>
<body>
    <h1>トイレ情報を入力</h1>
    
    <form action="/save" method="post" th:object="${toilet}">
        
        <input type="hidden" th:field="*{id}">
        
        <p>名前：<br>
        <input type="text" th:field="*{name}" required></p>
        
        <p>住所：<br>
        <input type="text" th:field="*{address}"></p>
        
        <p>説明：<br>
        <textarea th:field="*{description}" rows="3"></textarea></p>

        <hr>
        <h3>地図用の設定</h3>
        <p>緯度 (例: 36.0834)：<br>
        <input type="text" th:field="*{lat}"></p>

        <p>経度 (例: 140.1133)：<br>
        <input type="text" th:field="*{lng}"></p>

        <h3>設備情報</h3>
        <p>
            <label><input type="checkbox" th:field="*{wheelchair}"> 車椅子対応</label><br>
            <label><input type="checkbox" th:field="*{diaper}"> オムツ替えスペース</label><br>
            <label><input type="checkbox" th:field="*{open24h}"> 24時間利用可能</label>
        </p>
        <button type="submit">保存する</button>
    </form>
    
    <br>
    <a href="/">一覧に戻る</a>
</body>
</html>
