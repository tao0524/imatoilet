/* =========================================================
   search.css (3カラム・フルハイト版 + モバイル対応)
========================================================= */

/* ページ全体のラッパー：ヘッダー以外の高さを確保 */
.search-page-wrapper {
  height: calc(100vh - 64px); /* ヘッダーの高さを引く */
  overflow: hidden; /* 全体スクロールはさせない（PC時） */
  background: #f0f2f5;
  width: 100%;
}

/* 既存コンテナの無効化（検索ページ内のみ） */
.search-page-wrapper .container {
  max-width: none !important;
  padding: 0 !important;
  margin: 0 !important;
  height: 100%;
  width: 100%;
}

/* --- 3カラムレイアウト定義 (PC用デフォルト) --- */
.three-col-layout {
  display: grid;
  /* 左:260px, 中:残り全部, 右:320px */
  grid-template-columns: 260px 1fr 320px;
  grid-template-rows: 100%;
  height: 100%;
  width: 100%;
}

/* =========================
   左カラム: フィルタ
========================= */
.col-filter {
  background: #fff;
  border-right: 1px solid #ddd;
