/* =========================================
   css/pages/index.css
   トップページ専用スタイル（スマホ・PC共通）
========================================= */

/* --- 全体のレイアウト調整 --- */
body {
  background-color: #f9f9f9; /* 全体の背景色 */
}

.top-main {
  padding: 30px 0 60px;
  min-height: 80vh; /* 画面の高さを確保 */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* --- 1. ヘッダー（ロゴ） --- */
.site-header {
  padding: 15px 0;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.logo {
  font-weight: 800;
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  justify-content: center; /* スマホは中央寄せ */
  color: #333;
}

.logo-icon {
  font-size: 1.8rem;
  margin: 0 4px;
}
.logo-now {
  background-color: #1e88e5; 
  color: #fff;               
  font-size: 0.9em;          
  padding: 2px 8px;          
  border-radius: 6px;        
  margin-right: 6px;         
  transform: translateY(3px); 
}
.logo-main { color: #1e88e5; }


/* --- 2. ヒーローエリア（キャッチコピー） --- */
.hero {
  text-align: center;
  /* マージンやパディングも可変にして、狭い画面での圧迫感を減らす */
  margin-bottom: clamp(20px, 4vw, 40px);
  padding-top: clamp(10px, 3vw, 30px);
}

.catch {
  /* スマホ 1.8rem -> PC 3.2rem まで滑らかに拡大 */
  font-size: clamp(1.8rem, 5vw, 3.2rem);
  font-weight: 800;
  line-height: 1.4;
  color: #1e88e5;
  margin-bottom: clamp(16px, 3vw, 24px);
}

.sub {
  /* スマホ 0.95rem -> PC 1.2rem まで滑らかに拡大 */
  font-size: clamp(0.95rem, 2vw, 1.2rem);
  color: #546e7a;
  line-height: 1.6;
  font-weight: bold;
}

